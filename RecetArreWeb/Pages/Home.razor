@page "/"
@inject NavigationManager navigation

<PageTitle>RecetArreWeb - Inicio</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center text-center mb-5">
        <div class="col-12 col-lg-8">
            <div class="bg-brand text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                 style="width: 80px; height: 80px; font-size: 2rem;">
                <span class="bi bi-journal-richtext"></span>
            </div>
            <h1 class="display-5 fw-bold text-brand">Bienvenido a RecetArreWeb</h1>
            <p class="lead text-muted mb-4">
                Tu espacio para guardar, organizar y compartir tus recetas favoritas.
                Crea, edita y valora recetas con comentarios y estrellas.
            </p>
            <AuthorizeView>
                <Authorized>
                    <a href="/recetas" class="btn btn-brand btn-lg me-2">
                        <span class="bi bi-book me-2"></span>Ver mis recetas
                    </a>
                    <a href="/recetas/crear" class="btn btn-outline-secondary btn-lg">
                        <span class="bi bi-plus-circle me-2"></span>Nueva receta
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="btn btn-brand btn-lg me-2">
                        <span class="bi bi-box-arrow-in-right me-2"></span>Iniciar sesión
                    </a>
                    <a href="/registro" class="btn btn-outline-secondary btn-lg">
                        <span class="bi bi-person-plus me-2"></span>Crear cuenta
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <div class="text-brand mb-3" style="font-size: 2.5rem;">
                    <span class="bi bi-pencil-square"></span>
                </div>
                <h5 class="fw-semibold">Crea tus recetas</h5>
                <p class="text-muted mb-0">
                    Escribe tus recetas con instrucciones detalladas, tiempos de preparación y porciones.
                </p>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <div class="text-brand mb-3" style="font-size: 2.5rem;">
                    <span class="bi bi-tags"></span>
                </div>
                <h5 class="fw-semibold">Organiza por categorías</h5>
                <p class="text-muted mb-0">
                    Clasifica tus recetas por categorías e ingredientes para encontrarlas fácilmente.
                </p>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <div class="text-brand mb-3" style="font-size: 2.5rem;">
                    <span class="bi bi-star"></span>
                </div>
                <h5 class="fw-semibold">Comenta y valora</h5>
                <p class="text-muted mb-0">
                    Deja comentarios y valoraciones en las recetas para compartir tu experiencia.
                </p>
            </div>
        </div>
    </div>
</div>
